generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  patient
  caregiver
  family
  admin
}

model User {
  id                 String   @id
  role               Role
  name               String
  email              String   @unique
  verificationStatus String
  createdAt          DateTime @default(now())
}

model Patient {
  id              String   @id
  userId          String   @unique
  demographics    Json
  carePlan        String
  allergies       Json
  comorbidities   Json
  emergencyContacts Json
  consent         Json
}

model Visit {
  id          String   @id
  patientId   String
  caregiverId String
  startTime   DateTime
  endTime     DateTime?
  status      String
  visitType   String
  durationMins Int?
  rate        Float?
}

model AuditLog {
  id         String   @id
  actor      String
  action     String
  targetType String
  targetId   String
  timestamp  DateTime @default(now())
  metadata   Json
}
